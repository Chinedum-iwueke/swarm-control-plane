[Unit]
Description=Hermes restricted Telegram founder gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=swarm-telegram
Group=swarm-telegram
WorkingDirectory=/srv/invariance/swarm/repositories/swarm-control-plane/telegram-gateway
EnvironmentFile=/etc/invariance-swarm/telegram-gateway.env
LoadCredential=telegram_bot_token:/etc/invariance-swarm/telegram-bot.token
LoadCredential=founder_channel_token:/etc/invariance-swarm/founder-channel.token
Environment=HERMES_TELEGRAM_BOT_TOKEN_FILE=/run/credentials/hermes-telegram-gateway.service/telegram_bot_token
Environment=HERMES_TELEGRAM_FOUNDER_CHANNEL_TOKEN_FILE=/run/credentials/hermes-telegram-gateway.service/founder_channel_token
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/srv/invariance/swarm/repositories/swarm-control-plane/telegram-gateway/.venv/bin:/usr/bin:/bin
ExecStart=/srv/invariance/swarm/repositories/swarm-control-plane/telegram-gateway/.venv/bin/hermes-telegram-gateway run

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-telegram-gateway

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/invariance/swarm/telegram-gateway

[Install]
WantedBy=multi-user.target
