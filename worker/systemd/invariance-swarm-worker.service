[Unit]
Description=Invariance Swarm restricted VM1 worker
Documentation=file:/home/omenka/Projects/swarm-control-plane/worker/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/swarm-control-plane/worker
EnvironmentFile=/etc/invariance-swarm/vm1-worker.env
ReadOnlyPaths=/etc/invariance-swarm/codex-worker
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin:/usr/bin:/bin
Environment=VIRTUAL_ENV=/home/omenka/Projects/swarm-control-plane/worker/.venv
ExecStart=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin/invariance-swarm-worker run

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=50
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=invariance-swarm-worker

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=-/home/omenka/Projects/swarm-agent-workspaces
ReadWritePaths=-/home/omenka/Projects/swarm-control-plane/.git/worktrees
ReadWritePaths=-/home/omenka/Projects/bulletproof_bt/.git/worktrees
ReadWritePaths=-/home/omenka/Projects/invariance_research/.git/worktrees

[Install]
WantedBy=multi-user.target
