[Unit]
Description=Hermes bounded scientific method designer (commissioning only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/swarm-control-plane/worker
EnvironmentFile=/etc/invariance-swarm/alpha-method-designer.env
EnvironmentFile=/etc/invariance-swarm/codex-discovery-runtime.env
Environment=SWARM_ENGINEERING_AUTHOR_PROVIDER=codex
Environment=SWARM_ENGINEERING_VIRTUALENV=/home/omenka/Projects/bulletproof_bt/.venv
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NODE_OPTIONS=--jitless
Environment=PATH=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin:/usr/bin:/bin
Environment=VIRTUAL_ENV=/home/omenka/Projects/swarm-control-plane/worker/.venv
ExecStart=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin/invariance-swarm-worker run
Restart=on-failure
RestartSec=30
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=100%
TasksMax=128
ReadOnlyPaths=/home/omenka/Projects/bulletproof_bt
ReadWritePaths=/var/lib/invariance-swarm/codex-discovery-runtime
ReadWritePaths=/home/omenka/Projects/swarm-agent-workspaces
ReadWritePaths=/home/omenka/Projects/bulletproof_bt/.git/worktrees

[Install]
WantedBy=multi-user.target
