[Unit]
Description=Hermes restricted native alpha strategy engineer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/swarm-control-plane/worker
EnvironmentFile=/etc/invariance-swarm/alpha-strategy-engineer.env
Environment=SWARM_CODEX_HOME=/var/lib/invariance-swarm/codex-alpha-strategy-engineer-runtime
Environment=SWARM_ENGINEERING_VIRTUALENV=/home/omenka/Projects/bulletproof_bt/.venv
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NODE_OPTIONS=--jitless
Environment=PATH=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin:/usr/bin:/bin
Environment=VIRTUAL_ENV=/home/omenka/Projects/swarm-control-plane/worker/.venv
ExecStart=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin/invariance-swarm-worker run
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadOnlyPaths=/home/omenka/Projects/bulletproof_bt
ReadOnlyPaths=/etc/invariance-swarm/codex-worker
BindReadOnlyPaths=/etc/invariance-swarm/codex-worker/auth.json:/var/lib/invariance-swarm/codex-alpha-strategy-engineer-runtime/auth.json
ReadWritePaths=/var/lib/invariance-swarm/codex-alpha-strategy-engineer-runtime
ReadWritePaths=/home/omenka/Projects/swarm-agent-workspaces
ReadWritePaths=/home/omenka/Projects/bulletproof_bt/.git/worktrees
ReadWritePaths=/home/omenka/.local/state/invariance-swarm
ReadWritePaths=/home/omenka/.local/share/invariance-swarm

[Install]
WantedBy=multi-user.target
