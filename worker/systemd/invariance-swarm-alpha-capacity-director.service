[Unit]
Description=Bulletproof deterministic global research capacity director
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/bulletproof_bt
Environment=PYTHONPATH=/home/omenka/Projects/bulletproof_bt/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/home/omenka/Projects/bulletproof_bt/.venv/bin/python orchestrator/global_capacity_scheduler.py --db /home/omenka/.local/state/invariance-swarm/research-capacity.sqlite --config /etc/invariance-swarm/alpha-capacity.yaml
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/omenka/.local/state/invariance-swarm
ReadWritePaths=/home/omenka/Projects/swarm-agent-workspaces
ReadWritePaths=/home/omenka/.local/share/invariance-swarm/alpha002-bundles

[Install]
WantedBy=multi-user.target
