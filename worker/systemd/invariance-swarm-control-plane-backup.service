[Unit]
Description=Hermes verified control-plane PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=invariance-swarm-backup-readers
EnvironmentFile=-/etc/invariance-swarm/control-plane-backup.env
Environment=PATH=/opt/invariance-swarm-worker/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DOCKER_CONFIG=/run/invariance-swarm-control-plane-backup/docker-config
ExecStart=/srv/invariance/swarm/control-plane-runtime/scripts/backup-database.sh
RuntimeDirectory=invariance-swarm-control-plane-backup
RuntimeDirectoryMode=0750
UMask=0027
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadWritePaths=/srv/invariance/swarm/control-plane-runtime/backups /run/invariance-swarm /run/invariance-swarm-control-plane-backup
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
