[Unit]
Description=Invariance Swarm restricted VM2 infrastructure broker
After=docker.service network-online.target
Requires=docker.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=invariance-swarm-infrastructure
SupplementaryGroups=invariance-swarm-backup-readers
WorkingDirectory=/srv/invariance/swarm/control-plane-runtime
ExecStart=/srv/invariance/swarm/repositories/swarm-control-plane/worker/.venv/bin/invariance-swarm-infrastructure-broker
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/invariance/swarm/control-plane-runtime
ReadOnlyPaths=/etc/invariance-swarm/infrastructure-broker.secret
ReadWritePaths=/run/invariance-swarm-infrastructure
ReadWritePaths=/var/lib/invariance-swarm-infrastructure
RuntimeDirectory=invariance-swarm-infrastructure
RuntimeDirectoryMode=0750
StateDirectory=invariance-swarm-infrastructure
StateDirectoryMode=0700
TimeoutStopSec=20s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
