[Unit]
Description=Invariance Swarm restricted VM1 research runner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/swarm-control-plane/worker
EnvironmentFile=/etc/invariance-swarm/vm1-research-worker.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin:/usr/bin:/bin
Environment=VIRTUAL_ENV=/home/omenka/Projects/swarm-control-plane/worker/.venv
ExecStart=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin/invariance-swarm-worker run
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/home/omenka/Projects/bulletproof_bt
ReadWritePaths=/home/omenka/Projects/swarm-agent-workspaces
ReadWritePaths=/home/omenka/Projects/bulletproof_bt/.git/worktrees
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
