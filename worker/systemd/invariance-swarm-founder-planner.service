[Unit]
Description=Invariance Swarm restricted founder intake planner
Documentation=file:/home/omenka/Projects/swarm-control-plane/worker/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=omenka
Group=omenka
WorkingDirectory=/home/omenka/Projects/swarm-control-plane/worker
EnvironmentFile=/etc/invariance-swarm/vm1-founder-planner.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PATH=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin:/usr/bin:/bin
Environment=VIRTUAL_ENV=/home/omenka/Projects/swarm-control-plane/worker/.venv
ExecStart=/home/omenka/Projects/swarm-control-plane/worker/.venv/bin/invariance-swarm-founder-planner run

Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=invariance-swarm-founder-planner

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=-/etc/invariance-swarm/codex-planner
ReadWritePaths=-/home/omenka/Projects/swarm-agent-workspaces/founder-intake

[Install]
WantedBy=multi-user.target
