[Unit]
Description=Hermes isolated control-plane restore drill
After=docker.service invariance-swarm-control-plane-backup.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=invariance-swarm-backup-readers
SupplementaryGroups=docker
EnvironmentFile=-/etc/invariance-swarm/control-plane-backup.env
Environment=DOCKER_CONFIG=/run/invariance-swarm-control-plane-restore-drill/docker-config
ExecStart=/opt/invariance-swarm-worker/bin/invariance-swarm-control-plane-backup restore-drill
RuntimeDirectory=invariance-swarm-control-plane-restore-drill
RuntimeDirectoryMode=0750
UMask=0027
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/invariance/swarm/control-plane-runtime/backups /run/invariance-swarm /run/invariance-swarm-control-plane-restore-drill
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
RestrictRealtime=yes
